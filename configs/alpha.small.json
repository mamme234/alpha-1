{
  "preset": "small",
  "model": {
    "name": "alpha-small",
    "version": "0.1.0",
    "vocabSize": 2048,
    "contextLength": 128,
    "dModel": 128,
    "nHeads": 8,
    "nLayers": 4,
    "dFeedForward": 512,
    "dropout": 0.1,
    "normEps": 1e-05,
    "positionalEncoding": "learned",
    "tieEmbeddings": true,
    "initStd": 0.02
  },
  "tokenizer": {
    "targetVocabSize": 1024,
    "version": "0.1.0",
    "specialTokens": {
      "pad": "<pad>",
      "unk": "<unk>",
      "bos": "<bos>",
      "eos": "<eos>"
    }
  },
  "training": {
    "batchSize": 12,
    "seqLen": 96,
    "totalSteps": 400,
    "learningRate": 0.0015,
    "schedule": "cosine",
    "warmupSteps": 40,
    "minFactor": 0.1,
    "weightDecay": 0.01,
    "gradClipNorm": 1,
    "evalInterval": 40,
    "evalBatches": 8,
    "validationFraction": 0.12,
    "seed": 1337,
    "checkpointInterval": 100
  },
  "rag": {
    "chunkTokens": 96,
    "overlapTokens": 24,
    "topK": 6,
    "minScore": 0.05,
    "maxContextTokens": 640
  },
  "memory": {
    "recencyHalfLifeHours": 72,
    "similarityWeight": 0.6,
    "importanceWeight": 0.25,
    "usageWeight": 0.15,
    "maxPerScope": 2048
  },
  "security": {
    "approvalTtlMs": 300000,
    "sandbox": {
      "maxSteps": 10,
      "maxGeneratedTokens": 4096,
      "maxDurationMs": 300000,
      "allowNetwork": false,
      "allowFileSystem": false
    },
    "rateLimits": {
      "inference": 60,
      "tool": 40,
      "agent": 12,
      "workflow": 24
    }
  },
  "automation": {
    "maxAttempts": 4,
    "baseRetryDelayMs": 500,
    "historyLimit": 500
  },
  "observability": {
    "logLevel": "info",
    "sampleWindow": 2000,
    "maxSpans": 16000
  }
}
