# they live in Convex (see src/convex/alpha) or in a local directory.
.alpha/
*.checkpoint.json
*.weights.json

# Editor and OS noise
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
bun-error.log*
